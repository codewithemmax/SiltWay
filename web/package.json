{
  "name": "flood-router-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun ./node_modules/next/dist/bin/next dev",
    "build": "bun ./node_modules/typescript/bin/tsc --noEmit && bun build ./src/app/page.tsx --outdir ./.next/bundle --target browser",
    "next-build": "bun ./node_modules/next/dist/bin/next build",
    "start": "bun ./node_modules/next/dist/bin/next start",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "mapbox-gl": "3.34.2",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/mapbox-gl": "3.5.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
